--- check.mts:
import { parseMessage, formatMessage } from "./messages.ts";
import { readFileSync } from "node:fs";
const en = JSON.parse(readFileSync("en.json","utf8")), ru = JSON.parse(readFileSync("final-ru.json","utf8")), draft = JSON.parse(readFileSync("draft-ru.json","utf8"));
const set = (s:string)=>JSON.stringify([...parseMessage(s).params.entries()].sort());
let mism=0, n=0; const comp:string[]=[];
for (const k of Object.keys(en)) { n++; if (set(en[k])!==set(ru[k])) {mism++; console.log("MISMATCH",k);} if (parseMessage(en[k]).params.has("computer")) comp.push(k); }
console.log(`keys=${n} draft=${Object.keys(draft).length} placeholder_mismatch=${mism}`);
// negative controls
console.log("neg1 injected mismatch detected:", set(en["mobile.refusal.relay_stopped.title"])!==set("{computr}: Local Operator не запущен."));
try { parseMessage("{computer: сломано"); console.log("neg2 malformed: NOT rejected"); } catch(e:any){ console.log("neg2 malformed rejected:", e.constructor.name); }
console.log(`computer_keys=${comp.length}`);
for (const k of comp) { const ruHas = parseMessage(ru[k]).params.has("computer"); console.log(`\n${k} ${draft[k]!==undefined?"[draft]":"[shipped]"} ruHas=${ruHas}`);
 for (const c of ["Домашний ноутбук","Ваш компьютер","192.168.1.24","MacBook Pro"]) console.log("  "+formatMessage(parseMessage(ru[k]),{computer:c},"ru")); }
